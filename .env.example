# APP_URL: The URL where this app runs.
APP_URL="MY_APP_URL"

# SUPABASE_URL: The public URL of your Supabase project. Get this from the API Settings page.
SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_ANON_KEY: The public anonymous API key for your Supabase project. Get this from the API Settings page.
SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Optional but recommended for server-side admin login checks.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# JWT_SECRET: A random secure secret used to sign secure session tokens. If left blank, a random one is generated at startup.
JWT_SECRET=

# PUBLIC_SITE_ORIGIN: Public website origin allowed to read availability and submit booking requests.
PUBLIC_SITE_ORIGIN="https://zavarihaus.vercel.app"
